<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP is allowed so a failure drill can point the app at a local
     server on the computer (adb reverse) that answers 503. Release builds stay HTTPS only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
