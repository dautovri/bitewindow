    "No finished trips yet. Log every trip, blank ones included.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen afsluttede ture endnu. Log hver tur, også nulture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine beendeten Touren. Trag jede Tour ein, auch Schneidertouren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay salidas terminadas. Registra todas tus salidas, también las que acaben sin capturas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä päättyneitä reissuja. Kirjaa jokainen reissu, myös tyhjät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sortie terminée pour l’instant. Notez chaque sortie, bredouilles comprises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna uscita conclusa. Registra ogni uscita, cappotti compresi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了した釣行はまだありません。ボウズの日も含めて毎回記録しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 완료된 출조가 없습니다. 꽝 친 날까지 빠짐없이 기록하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fullførte turer ennå. Loggfør hver tur, også bomturer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen afgeronde sessies. Log elke sessie, ook als je blankt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zakończonych wypraw. Zapisuj każdą wyprawę, także te bez ryby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pescaria concluída ainda. Registre todas as pescarias, inclusive as sem peixe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершённых рыбалок пока нет. Записывайте каждую рыбалку, в том числе без улова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga avslutade turer än. Logga varje tur, även bomturer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz tamamlanmış av yok. Boş dönülenler dahil her avı kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершених риболовель поки немає. Записуйте кожну риболовлю, зокрема й без улову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有已结束的出钓。每次出钓都记下来，空军也算。"
          }
        }
      }
    },
