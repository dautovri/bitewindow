    "Relative to the starting estimate. It moves slowly until about 20 trips are logged.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I forhold til startskønnet. Ændrer sig langsomt, indtil omkring 20 ture er logget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Vergleich zur Startschätzung. Ändert sich nur langsam, bis etwa 20 Touren eingetragen sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En relación con la estimación inicial. Cambia despacio hasta que haya unas 20 salidas registradas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhteessa lähtöarvioon. Muuttuu hitaasti, kunnes reissuja on kirjattu noin 20."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par rapport à l’estimation de départ. Il évolue lentement jusqu’à environ 20 sorties notées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispetto alla stima iniziale. Cambia lentamente finché non sono registrate circa 20 uscite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期推定値との比較です。約20回の釣行を記録するまではゆっくり変化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기 추정치 대비 값입니다. 출조를 20회 정도 기록할 때까지는 천천히 변합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I forhold til startanslaget. Endrer seg sakte til rundt 20 turer er loggført."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten opzichte van de startschatting. Verandert langzaam tot er ongeveer 20 sessies zijn gelogd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Względem szacunku początkowego. Zmienia się powoli, dopóki nie zapiszesz około 20 wypraw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em relação à estimativa inicial. Muda devagar até que cerca de 20 pescarias sejam registradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относительно начальной оценки. Меняется медленно, пока не записано около 20 рыбалок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämfört med startuppskattningen. Ändras långsamt tills ungefär 20 turer har loggats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlangıç tahminine göredir. Yaklaşık 20 av kaydedilene kadar yavaş değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відносно початкової оцінки. Змінюється повільно, доки не записано близько 20 риболовель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对于初始估算值。记录约 20 次出钓之前变化较慢。"
          }
        }
      }
    },
