    "Unlock hourly curve, tide curve, expected catch and 10-day outlook": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås op for timekurve, tidevandskurve, forventet fangst og 10-dages udsigt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stündliche Kurve, Tidenkurve, erwarteten Fang und 10-Tage-Ausblick freischalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea la curva por horas, la curva de marea, las capturas esperadas y la previsión a 10 días"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa tuntikäyrä, vuorovesikäyrä, saalisodote ja 10 päivän näkymä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez la courbe horaire, la courbe de marée, les prises attendues et la tendance à 10 jours"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca curva oraria, curva di marea, catture attese e tendenza a 10 giorni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1時間ごとの曲線、潮汐曲線、予想釣果、10日間予報をアンロック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간별 곡선, 조석 곡선, 예상 조과, 10일 전망 잠금 해제"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp timekurve, tidevannskurve, forventet fangst og 10-dagersutsikt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel uurcurve, getijcurve, verwachte vangst en 10-daagse vooruitblik"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj krzywą godzinową, krzywą pływów, oczekiwany połów i prognozę 10-dniową"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie a curva por hora, a curva de maré, a captura esperada e a previsão de 10 dias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте почасовую кривую, кривую приливов, ожидаемый улов и прогноз на 10 дней"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp timkurva, tidvattenkurva, förväntad fångst och 10-dagarsutsikt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatlik eğri, gelgit eğrisi, beklenen balık miktarı ve 10 günlük görünümün kilidini açın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте погодинну криву, криву припливів, очікуваний улов і прогноз на 10 днів"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁逐小时曲线、潮汐曲线、预期鱼获和 10 天展望"
          }
        }
      }
    },
