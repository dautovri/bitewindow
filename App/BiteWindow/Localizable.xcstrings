    "Open this spot on the Forecast tab to download weather.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn pladsen under Prognose for at hente vejret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne diesen Spot im Tab „Prognose“, um das Wetter zu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre este punto en la pestaña Pronóstico para descargar el tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa paikka Ennuste-välilehdellä ladataksesi sään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez ce spot dans l’onglet Prévisions pour télécharger la météo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri questo spot nella scheda Previsioni per scaricare il meteo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報タブでこのスポットを開いて天気をダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예보 탭에서 이 포인트를 열어 날씨를 받으세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne plassen i Prognose-fanen for å laste ned været."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open deze stek op het tabblad Voorspelling om het weer te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz to łowisko w karcie Prognoza, aby pobrać pogodę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra este ponto na aba Previsão para baixar o tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте это место на вкладке «Прогноз», чтобы загрузить погоду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna platsen på fliken Prognos för att hämta vädret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumunu indirmek için bu noktayı Tahmin sekmesinde açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте це місце на вкладці «Прогноз», щоб завантажити погоду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“预报”标签中打开此钓点以下载天气。"
