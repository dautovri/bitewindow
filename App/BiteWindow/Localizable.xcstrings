    "Bite windows are estimates from weather, sun, moon and tide. Fish don't read forecasts.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugvinduer er skøn ud fra vejr, sol, måne og tidevand. Fisk læser ikke vejrudsigter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beißfenster sind Schätzungen aus Wetter, Sonne, Mond und Gezeiten. Fische lesen keinen Wetterbericht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas de picada son estimaciones a partir del tiempo, el sol, la luna y la marea. Los peces no leen el pronóstico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syönti-ikkunat ovat säästä, auringosta, kuusta ja vuorovedestä laskettuja arvioita. Kalat eivät lue ennusteita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les créneaux d’activité sont des estimations basées sur la météo, le soleil, la lune et la marée. Les poissons ne lisent pas les prévisions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre di attività sono stime basate su meteo, sole, luna e marea. I pesci non leggono le previsioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時合いは天気・太陽・月・潮汐からの推定です。魚は予報を読みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입질 시간대는 날씨, 해, 달, 조석을 바탕으로 한 추정치입니다. 물고기는 예보를 읽지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nappvinduer er anslag ut fra vær, sol, måne og tidevann. Fisken leser ikke værmeldingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijtvensters zijn schattingen op basis van weer, zon, maan en getij. Vissen lezen geen weerbericht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okna brań to szacunki na podstawie pogody, słońca, księżyca i pływów. Ryby nie czytają prognoz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas de atividade são estimativas com base no tempo, sol, lua e maré. Os peixes não leem a previsão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна клёва — это оценка по погоде, солнцу, луне и приливам. Рыба прогнозов не читает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Huggfönster är uppskattningar utifrån väder, sol, måne och tidvatten. Fiskar läser inte prognoser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivite pencereleri hava durumu, güneş, ay ve gelgitten yapılan tahminlerdir. Balıklar tahmin okumaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вікна кльову — це оцінка за погодою, сонцем, місяцем і припливами. Риба прогнозів не читає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "咬钩窗口是根据天气、日月和潮汐估算的结果。鱼可不会看预报。"
          }
        }
      }
    },
