    "Tide predictions from NOAA harmonic constants. Not for navigation.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidevandsprognoser fra NOAA's harmoniske konstanter. Ikke til navigation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezeitenvorhersagen aus harmonischen Konstanten der NOAA. Nicht für die Navigation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predicciones de marea a partir de constantes armónicas de NOAA. No apto para la navegación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuorovesiennusteet perustuvat NOAA:n harmonisiin vakioihin. Ei navigointiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prédictions de marée à partir des constantes harmoniques de la NOAA. Ne pas utiliser pour la navigation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsioni di marea da costanti armoniche NOAA. Non adatte alla navigazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "潮汐予測はNOAAの調和定数に基づきます。航海には使用しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조석 예측은 NOAA 조화 상수를 기반으로 합니다. 항해용이 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidevannsvarsler fra NOAAs harmoniske konstanter. Ikke for navigasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Getijvoorspellingen op basis van harmonische constanten van NOAA. Niet voor navigatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognozy pływów na podstawie stałych harmonicznych NOAA. Nie do nawigacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsões de maré a partir de constantes harmônicas da NOAA. Não use para navegação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз приливов по гармоническим постоянным NOAA. Не для навигации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidvattenprognoser från NOAA:s harmoniska konstanter. Inte för navigering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelgit tahminleri NOAA harmonik sabitlerine dayanır. Seyir amacıyla kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз припливів за гармонічними сталими NOAA. Не для навігації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "潮汐预测基于 NOAA 调和常数。不可用于航海。"
          }
        }
      }
    },
