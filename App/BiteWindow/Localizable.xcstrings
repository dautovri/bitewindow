    "Conditions that suit each fish, not a survey of this water.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhold, der passer til hver fisk – ikke en opgørelse over dette vand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedingungen, die zu jedem Fisch passen – keine Bestandsaufnahme dieses Gewässers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Condiciones que convienen a cada pez, no un censo de esta agua."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olosuhteet, jotka sopivat kullekin kalalle – ei tämän vesistön kalakartoitus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions favorables à chaque poisson, pas un inventaire de ce plan d’eau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condizioni adatte a ciascun pesce, non un censimento di quest’acqua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各魚に合う条件であり、この水域の生息調査ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 어종에 맞는 조건이며, 이 수역의 서식 조사가 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhold som passer hver fisk – ikke en kartlegging av dette vannet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omstandigheden die bij elke vis passen, geen inventarisatie van dit water."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warunki sprzyjające każdej rybie, a nie spis ryb w tym łowisku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Condições que favorecem cada peixe, não um levantamento desta água."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Условия, подходящие каждой рыбе, а не данные о том, кто живёт в этом водоёме."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhållanden som passar varje fisk – inte en inventering av vattnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her balığa uygun koşullar; bu suyun balık envanteri değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Умови, що підходять кожній рибі, а не дані про те, хто живе в цій водоймі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合各鱼种的条件，并非该水域的鱼类调查。"
          }
        }
      }
    },
