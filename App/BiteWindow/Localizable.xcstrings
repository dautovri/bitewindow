    "Hourly bite curve, tide curve, expected catch tuned to your log, 10-day outlook and unlimited spots.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugkurve time for time, tidevandskurve, forventet fangst tilpasset din logbog, 10-dages udsigt og ubegrænset antal pladser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stündliche Beißkurve, Tidenkurve, erwarteter Fang, abgestimmt auf dein Fangbuch, 10-Tage-Ausblick und unbegrenzt viele Spots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva de picada por horas, curva de marea, capturas esperadas ajustadas a tu diario, previsión a 10 días y lugares ilimitados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuntikohtainen syöntikäyrä, vuorovesikäyrä, päiväkirjaasi mukautuva saalisodote, 10 päivän näkymä ja rajattomasti paikkoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courbe d’activité heure par heure, courbe de marée, prises attendues ajustées à votre carnet, tendance à 10 jours et spots illimités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva oraria di attività, curva di marea, catture attese calibrate sul tuo diario, tendenza a 10 giorni e spot illimitati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1時間ごとの活性曲線、潮汐曲線、記録に合わせて調整される予想釣果、10日間予報、無制限のポイント登録。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간별 입질 곡선, 조석 곡선, 내 기록에 맞춘 예상 조과, 10일 전망, 무제한 포인트."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nappkurve time for time, tidevannskurve, forventet fangst tilpasset loggen din, 10-dagersutsikt og ubegrenset antall plasser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijtcurve per uur, getijcurve, verwachte vangst afgestemd op je logboek, 10-daagse vooruitblik en onbeperkt stekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzinowa krzywa brań, krzywa pływów, oczekiwany połów dopasowany do Twojego dziennika, prognoza 10-dniowa i nieograniczona liczba łowisk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva de atividade por hora, curva de maré, captura esperada ajustada ao seu diário, previsão de 10 dias e pontos ilimitados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почасовая кривая клёва, кривая приливов, ожидаемый улов с учётом вашего журнала, прогноз на 10 дней и неограниченное число мест."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Huggkurva timme för timme, tidvattenkurva, förväntad fångst anpassad efter din loggbok, 10-dagarsutsikt och obegränsat antal platser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatlik aktivite eğrisi, gelgit eğrisi, günlüğünüze göre ayarlanan beklenen balık miktarı, 10 günlük görünüm ve sınırsız mera."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погодинна крива кльову, крива припливів, очікуваний улов з урахуванням вашого журналу, прогноз на 10 днів і необмежена кількість місць."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐小时咬钩曲线、潮汐曲线、根据你的日志调校的预期鱼获、10 天展望和无限钓点。"
          }
        }
      }
    },
