    "Fish suggestions are for freshwater spots.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiskeforslag gælder ferskvandspladser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fischvorschläge gibt es für Süßwasser-Spots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias de peces son para puntos de agua dulce."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalaehdotukset koskevat makean veden paikkoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
