    "Add a fishing spot from the Map tab to see its bite windows.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en fiskeplads under fanen Kort for at se dens hugvinduer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge im Tab „Karte“ einen Angelspot hinzu, um seine Beißfenster zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un lugar de pesca desde la pestaña Mapa para ver sus ventanas de picada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kalapaikka Kartta-välilehdeltä, niin näet sen syönti-ikkunat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un spot de pêche depuis l’onglet Carte pour voir ses créneaux d’activité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi uno spot di pesca dal pannello Mappa per vedere le sue finestre di attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マップタブで釣りポイントを追加すると、時合いが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 탭에서 낚시 포인트를 추가하면 입질 시간대를 볼 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en fiskeplass fra Kart-fanen for å se nappvinduene der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg in het tabblad Kaart een visstek toe om de bijtvensters te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj łowisko na karcie Mapa, aby zobaczyć jego okna brań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um ponto de pesca na aba Mapa para ver as janelas de atividade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте место рыбалки на вкладке «Карта», чтобы увидеть его окна клёва."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en fiskeplats under fliken Karta för att se dess huggfönster."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivite pencerelerini görmek için Harita sekmesinden bir mera ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте місце риболовлі на вкладці «Карта», щоб побачити його вікна кльову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“地图”标签页添加钓点，即可查看咬钩窗口。"
          }
        }
      }
    },
