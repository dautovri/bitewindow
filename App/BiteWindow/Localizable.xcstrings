    "Not enough forecast left for today.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For lidt prognose tilbage for i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für heute bleibt nicht genug Vorhersage übrig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda suficiente pronóstico para hoy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle päivälle ei ole riittävästi ennustetta jäljellä."
          }
