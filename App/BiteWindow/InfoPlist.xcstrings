{
  "sourceLanguage": "en",
  "strings": {
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aflæser barometeret i din iPhone for at følge tryktendensen i realtid på din plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest das Barometer deines iPhones aus, um den aktuellen Drucktrend an deinem Spot zu verfolgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your phone's barometer to track the live pressure trend at your spot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el barómetro de tu teléfono para seguir en vivo la tendencia de la presión en tu lugar de pesca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukee puhelimesi ilmanpainemittaria seuratakseen reaaliaikaista painetrendiä paikallasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le baromètre de votre téléphone pour suivre en direct la tendance de la pression sur votre spot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge il barometro del tuo telefono per seguire in tempo reale la tendenza della pressione nel tuo spot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイントの気圧傾向をリアルタイムで把握するため、スマートフォンの気圧計を読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인트의 실시간 기압 추세를 추적하기 위해 휴대폰의 기압계를 읽습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser av barometeret i iPhonen din for å følge trykktrenden i sanntid på plassen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest de barometer van je iPhone uit om de actuele druktrend op je stek te volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje barometr telefonu, aby śledzić na żywo trend ciśnienia na Twoim łowisku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê o barômetro do seu telefone para acompanhar ao vivo a tendência da pressão no seu ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считывает показания барометра телефона, чтобы отслеживать тренд давления на вашем месте в реальном времени."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser av barometern i din iPhone för att följa trycktrenden i realtid på din plats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meranızdaki canlı basınç eğilimini izlemek için telefonunuzun barometresini okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зчитує показники барометра телефона, щоб відстежувати тренд тиску на вашому місці в реальному часі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取手机气压计，以追踪钓点的实时气压趋势。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrerer kortet på din position, når du trykker på lokalitetsknappen. Din lokalitet bliver på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentriert die Karte auf deine Position, wenn du auf die Standorttaste tippst. Dein Standort bleibt auf deinem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Centres the map on where you are when you tap the location button. Your location stays on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Centra el mapa donde estás al tocar el botón de ubicación. Tu ubicación no sale de tu iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskittää kartan sijaintiisi, kun napautat sijaintipainiketta. Sijaintitietosi pysyvät iPhonessasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Centre la carte sur votre position lorsque vous touchez le bouton de localisation. Votre position reste sur votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Centra la mappa su dove ti trovi quando tocchi il pulsante della posizione. La tua posizione resta sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地ボタンをタップしたときに、地図を現在地に合わせます。位置情報はiPhone内にのみ保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 버튼을 탭할 때 지도를 현재 위치로 이동합니다. 위치 정보는 사용자의 iPhone에만 보관됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentrerer kartet der du er når du trykker på posisjonsknappen. Posisjonen din forblir på iPhonen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Centreert de kaart op waar je bent wanneer je op de locatieknop tikt. Je locatie blijft op je iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyśrodkowuje mapę na Twojej pozycji po stuknięciu przycisku lokalizacji. Twoja lokalizacja pozostaje na iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Centraliza o mapa onde você está ao tocar no botão de localização. Sua localização permanece no seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центрирует карту по вашему местоположению при нажатии кнопки геопозиции. Данные о геопозиции остаются на вашем iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrerar kartan på din position när du trycker på platsknappen. Din platsinformation stannar på din iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum düğmesine dokunduğunuzda haritayı bulunduğunuz yere ortalar. Konumunuz iPhone’unuzda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Центрує карту на вашому місцезнаходженні після натискання кнопки геопозиції. Ваша геопозиція залишається на вашому iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点定位按钮时将地图居中到您的当前位置。您的位置信息仅保留在您的 iPhone 上。"
          }
        }
      }
    }
  },
  "version": "1.0"
}