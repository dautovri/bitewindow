{
  "sourceLanguage": "en",
  "strings": {
    "Add a spot in BiteCurve to see its bite forecast here.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en fiskeplads i BiteCurve for at se dens hugprognose her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in BiteCurve einen Spot hinzu, um hier die Beißprognose zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un puesto en BiteCurve para ver aquí su previsión de picada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää kalapaikka BiteCurvessa nähdäksesi sen syöntiennusteen tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un coin dans BiteCurve pour voir ses prévisions ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi uno spot in BiteCurve per vederne qui le previsioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BiteCurveでポイントを追加すると、ここに時合い予報が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BiteCurve에서 포인트를 추가하면 여기에 입질 예보가 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en fiskeplass i BiteCurve for å se bittprognosen her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een stek toe in BiteCurve om hier de bijtverwachting te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj miejscówkę w BiteCurve, aby zobaczyć tutaj jej prognozę brań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um ponto no BiteCurve para ver a previsão aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте точку в BiteCurve, чтобы видеть здесь прогноз клёва."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en fiskeplats i BiteCurve för att se huggprognosen här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Av tahminini burada görmek için BiteCurve’de bir mera ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте точку в BiteCurve, щоб бачити тут прогноз клювання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 BiteCurve 中添加钓点即可在此查看鱼口预报。"
          }
        }
      }
    },
