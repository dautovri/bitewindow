    "Open BiteCurve to update the forecast.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn BiteCurve for at opdatere prognosen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne BiteCurve, um die Prognose zu aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre BiteCurve para actualizar la previsión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä ennuste avaamalla BiteCurve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez BiteCurve pour actualiser les prévisions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri BiteCurve per aggiornare le previsioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BiteCurveを開いて予報を更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예보를 업데이트하려면 BiteCurve를 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne BiteCurve for å oppdatere prognosen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open BiteCurve om de verwachting bij te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz BiteCurve, aby zaktualizować prognozę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o BiteCurve para atualizar a previsão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте BiteCurve, чтобы обновить прогноз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna BiteCurve för att uppdatera prognosen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahmini güncellemek için BiteCurve’ü açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте BiteCurve, щоб оновити прогноз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 BiteCurve 以更新预报。"
          }
        }
      }
    },
    "Your best spot and its best window, today or the next good day.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din bedste fiskeplads og det bedste tidsrum, i dag eller næste gode dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein bester Spot und das beste Zeitfenster – heute oder am nächsten guten Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mejor puesto y su mejor franja, hoy o el próximo día bueno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paras kalapaikkasi ja sen paras syöntiaika, tänään tai seuraavana hyvänä päivänä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre meilleur coin et son meilleur créneau, aujourd’hui ou le prochain bon jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo spot migliore e la fascia più favorevole, oggi o nel prossimo giorno buono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日または次の好条件の日のベストポイントとベストな時合い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 또는 다음 좋은 날의 최고 포인트와 피크 타임."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din beste fiskeplass og beste bittperiode, i dag eller neste gode dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je beste stek en het beste tijdvak, vandaag of op de eerstvolgende goede dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja najlepsza miejscówka i jej najlepsze okno brań – dziś lub w kolejny dobry dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu melhor ponto e o melhor horário, hoje ou no próximo dia bom."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша лучшая точка и время выхода рыбы — сегодня или в ближайший клёвый день."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din bästa fiskeplats och dess bästa huggperiod, idag eller nästa bra dag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün veya bir sonraki verimli günde en iyi meranız ve en iyi av saati."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша найкраща точка та час виходу риби — сьогодні або в найближчий вдалий день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天或下一个好钓日的最佳钓点与黄金窗口期。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
